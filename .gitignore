# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is the only place a new
# contributor learns which variables the app needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Sauvegardes de la base, déposées ou déchiffrées ici par mégarde.
#
# C'est le dépôt public d'un projet dont dix exports complets ont été
# téléchargeables pendant huit jours en octobre 2026. Le mode d'emploi joint à
# chaque archive invite à la déchiffrer, et on le fait volontiers depuis le
# dossier du projet : sans ces règles, un `git add -A` suffirait à recommencer.
sauvegarde/
sauvegarde*.tar.gz
*.tar.gz.gpg
depot/
