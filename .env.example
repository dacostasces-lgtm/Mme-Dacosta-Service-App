# Supabase — copy to .env.local and fill in.
# Local dev: `supabase start` prints these (API URL + anon key).
# Production: Supabase Dashboard > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile Money — paiement manuel, sans API opérateur.
# Numéros marchands affichés à l'employeur au moment de régler la mise en
# relation. Laisser vide masque l'opérateur ; tout laisser vide affiche un
# repli WhatsApp plutôt qu'un faux numéro.
NEXT_PUBLIC_MOMO_MTN_NUMBER=
NEXT_PUBLIC_MOMO_AIRTEL_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=242067173030

# Relais SMS Mobile Money — encaissement automatique depuis la SIM marchand.
# Une application Android sur le téléphone qui porte la SIM relaie les SMS
# vers POST /api/momo/sms avec l'en-tête x-momo-relay-secret.
# Générer le secret avec : openssl rand -hex 32
MOMO_RELAY_SECRET=
# Expéditeurs acceptés, séparés par des virgules. Vide = tous (à ne garder que
# le temps du réglage).
MOMO_SMS_SENDERS=MobileMoney,MTN,AirtelMoney
# Clé service_role Supabase. JAMAIS préfixée NEXT_PUBLIC_ : elle contourne la
# RLS et ne doit jamais atteindre le navigateur.
SUPABASE_SERVICE_ROLE_KEY=
