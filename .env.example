# Supabase — copy to .env.local and fill in.
# Local dev: `supabase start` prints these (API URL + anon key).
# Production: Supabase Dashboard > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile Money — paiement manuel, sans API opérateur.
# Numéros marchands affichés à l'employeur au moment de régler la mise en
# relation. Laisser vide masque l'opérateur ; tout laisser vide affiche un
# repli WhatsApp plutôt qu'un faux numéro.
NEXT_PUBLIC_MOMO_MTN_NUMBER=
NEXT_PUBLIC_MOMO_AIRTEL_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=242067173030
